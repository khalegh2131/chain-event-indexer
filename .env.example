# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (local docker compose default)
DATABASE_URL=postgres://indexer:indexer_password@localhost:5432/chain_event_indexer

# RPC endpoint used by config/config.example.json through ${ETH_RPC_URL} interpolation.
# Never commit a real provider key here.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Optional API key. When empty, authentication is disabled.
API_KEY=

# Poller
POLLER_ENABLED=true

# Config file location (relative to the working directory, or absolute)
CONFIG_PATH=./config/config.json

# Optional: env file loaded into process.env before config interpolation (default ./.env)
ENV_FILE=./.env
